# Copie para .env e preencha. Nunca faça commit do .env.

# Crie a chave em https://console.groq.com/keys
GROQ_API_KEY=

# Um modelo por papel de agente, para o revisor poder ser mais forte que o gerador.
# Modelos disponíveis no plano gratuito: openai/gpt-oss-20b, openai/gpt-oss-120b,
# qwen/qwen3.8-27b (todos com saída estrita por JSON Schema).
MODELO_PLANEJADOR=openai/gpt-oss-20b
MODELO_GERADOR=openai/gpt-oss-20b
MODELO_REVISOR=openai/gpt-oss-120b

# Retentativas de transporte (limite de taxa, conexão, 5xx) e de validação da saída.
# O plano gratuito permite 8000 tokens por minuto: as retentativas esperam o limite liberar.
LLM_MAX_RETENTATIVAS=8
LLM_MAX_TENTATIVAS_VALIDACAO=3
LLM_MAX_CONCORRENCIA=2
LLM_TIMEOUT_SEGUNDOS=90
LLM_SAIDA_ESTRITA=true
LLM_ESFORCO_RACIOCINIO=low

# Agentes: nota mínima do revisor para aprovar, versões por questão antes de desistir,
# trechos recuperados por tópico e quanto do documento o planejador lê.
NOTA_MINIMA_REVISAO=7
MAX_TENTATIVAS_POR_QUESTAO=2
TRECHOS_POR_TOPICO=5
MAX_CARACTERES_PLANEJADOR=12000

# Postgres com pgvector. No docker compose o backend usa o host `db` e ignora este valor;
# este é o endereço do banco do compose visto do seu computador (testes e uv run).
URL_BANCO=postgresql+psycopg://provas:provas@localhost:5442/provas

# RAG. Embeddings rodam localmente. Na imagem Docker o modelo já vem baixado; fora dela,
# ele é baixado no primeiro envio (cerca de 240 MB) para DIRETORIO_MODELOS.
# Trocar por um modelo com outra dimensão de vetor exige uma migração do banco.
MODELO_EMBEDDINGS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Fora do Docker. No compose, o backend usa o modelo embutido na imagem (/opt/modelos).
DIRETORIO_MODELOS=dados/modelos
TAMANHO_TRECHO=400
SOBREPOSICAO_TRECHO=80
TAMANHO_MAX_UPLOAD_MB=20

# Origens autorizadas a chamar a API, separadas por vírgula (servidor de dev do React).
ORIGENS_CORS=http://localhost:5173

NIVEL_LOG=INFO
